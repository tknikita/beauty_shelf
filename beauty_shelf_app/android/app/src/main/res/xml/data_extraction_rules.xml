<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup and device-transfer rules.
     Backs up the SQLite DB, SharedPreferences and app files (product images). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
